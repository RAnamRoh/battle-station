{
  "name": "battle-station",
  "private": true,
  "description": "Browser 2D online fighting game where coworkers are the fighters.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "play": "pnpm --filter @bs/web build && pnpm --filter @bs/match exec wrangler dev --port 8787 --ip 0.0.0.0",
    "deploy": "pnpm --filter @bs/match run deploy",
    "content": "pnpm --filter @bs/content-schema build",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "spec": "openspec",
    "spec:list": "openspec list",
    "spec:validate": "openspec validate --all"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
